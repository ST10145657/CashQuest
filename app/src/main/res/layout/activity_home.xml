<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80DEEA"
    android:padding="16dp">

    <!-- Home Page Title -->
    <TextView
        android:id="@+id/homeMain"
        android:layout_width="375dp"
        android:layout_height="37dp"
        android:layout_marginTop="16dp"
        android:text="Home Page"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />




    <Button
        android:id="@+id/addExpenseBtn"
        android:layout_width="379dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        android:text="Add Expense"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499" />

    <Button
        android:id="@+id/setBudgetBtn"
        android:layout_width="379dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        android:text="Set Budget"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.612" />

    <Button
        android:id="@+id/expenseListBtn"
        android:layout_width="379dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        android:text="Expense List"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.715" />

    <Button
        android:id="@+id/reportsGraphsBtn"
        android:layout_width="379dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        android:text="Reports and Graphs"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.823" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#03A9F4"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.985">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/btnChart"
            android:layout_width="48dp"
            android:layout_height="29dp"
            android:layout_margin="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Chart"
            android:scaleType="fitCenter"
            android:src="@drawable/chart_icon" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/person_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/display"
        android:layout_width="377dp"
        android:layout_height="249dp"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.14" />
</androidx.constraintlayout.widget.ConstraintLayout>

